PORT=4000
# Postgres runs on a shared remote server, not locally via Docker (see CLAUDE.md Dev Environment Notes).
# The "nfs" database is dedicated to this project on that server — never point this at "ATS" or any other database on the same host.
DATABASE_URL="postgresql://<user>:<password>@<remote-postgres-host>:5432/nfs?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
